<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.FreeAirRadio.NavPillButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">20dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="backgroundTint">@color/nav_pill_background_color</item>
        <item name="android:textColor">@color/nav_pill_text_color</item>
        <item name="strokeWidth">0dp</item>
        <item name="rippleColor">?attr/colorPrimaryContainer</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.FreeAirRadio.DialogCard" parent="">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerHigh</item>
        <item name="cardCornerRadius">28dp</item>
        <item name="cardElevation">6dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.FreeAirRadio.DialogSectionCard" parent="">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="cardCornerRadius">@dimen/dialog_section_corner_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.FreeAirRadio.SettingsCard" parent="">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardUseCompatPadding">false</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.FreeAirRadio.StationCard" parent="">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="rippleColor">?attr/colorPrimaryContainer</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.FreeAirRadio.PlayerCard" parent="">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerHigh</item>
        <item name="cardCornerRadius">28dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.FreeAirRadio.SearchBarCard" parent="">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerHigh</item>
        <item name="cardCornerRadius">28dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.FreeAirRadio.FloatingSurfaceCard" parent="">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerHigh</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.FreeAirRadio.SettingsCardContent" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="Widget.FreeAirRadio.SettingsRadioButton" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="buttonTint">?attr/colorPrimary</item>
    </style>

    <style name="TextAppearance.FreeAirRadio.DialogTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.FreeAirRadio.DialogPrimaryButton" parent="Widget.Material3.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="cornerRadius">20dp</item>
        <item name="rippleColor">?attr/colorOnPrimary</item>
    </style>

    <style name="Widget.FreeAirRadio.DialogSecondaryButton" parent="Widget.Material3.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="backgroundTint">?attr/colorSurfaceContainerHigh</item>
        <item name="cornerRadius">20dp</item>
        <item name="rippleColor">?attr/colorPrimaryContainer</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.FreeAirRadio.StationFaviconImage" parent="">
        <item name="android:layout_width">@dimen/station_favicon_size</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:background">?attr/colorSurfaceVariant</item>
        <item name="android:contentDescription">@null</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:scaleType">centerCrop</item>
        <item name="android:src">@drawable/ic_station_favicon_default</item>
    </style>

    <style name="Widget.FreeAirRadio.PlayerArtworkImage" parent="">
        <item name="android:layout_width">@dimen/player_artwork_size</item>
        <item name="android:layout_height">@dimen/player_artwork_size</item>
        <item name="android:background">?attr/colorSurfaceVariant</item>
        <item name="android:contentDescription">@null</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:scaleType">centerCrop</item>
        <item name="android:src">@drawable/ic_station_favicon_default</item>
    </style>

    <style name="Widget.FreeAirRadio.PlayerActionButton" parent="Widget.Material3.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="backgroundTint">?attr/colorSurfaceContainerHigh</item>
        <item name="cornerRadius">24dp</item>
        <item name="iconTint">?attr/colorOnSurface</item>
        <item name="rippleColor">?attr/colorPrimaryContainer</item>
    </style>
</resources>
