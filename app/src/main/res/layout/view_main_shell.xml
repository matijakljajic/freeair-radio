<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/main_content_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:layout="@layout/fragment_homepage" />

    <View
        android:id="@+id/bottom_content_filter"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bottom_content_filter"
        android:importantForAccessibility="no" />

    <View
        android:id="@+id/status_bar_filter"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:background="@drawable/top_content_filter"
        android:importantForAccessibility="no" />

    <com.matijakljajic.freeairradio.ui.util.ContentWidthFrameLayout
        android:id="@+id/search_overlay_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="top|center_horizontal"
        android:clipChildren="false"
        android:clipToPadding="false">

        <include
            android:id="@+id/station_search_bar"
            layout="@layout/view_station_search_bar"
            android:visibility="gone"
            tools:visibility="visible" />

    </com.matijakljajic.freeairradio.ui.util.ContentWidthFrameLayout>

    <com.matijakljajic.freeairradio.ui.util.ContentWidthFrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:clipChildren="false"
        android:clipToPadding="false">

        <com.matijakljajic.freeairradio.ui.shell.BottomControlsContainer
            android:id="@+id/bottom_controls_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="@dimen/player_horizontal_margin"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="@dimen/player_horizontal_margin">

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/player_fragment_container"
                android:name="com.matijakljajic.freeairradio.ui.player.PlayerFragment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:layout="@layout/fragment_player" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FreeAirRadio.FloatingSurfaceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/main_nav_toggle_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:padding="0dp"
                    app:checkedButton="@id/nav_home_button"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/nav_home_button"
                        style="@style/Widget.FreeAirRadio.NavPillButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/nav_home" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/nav_search_button"
                        style="@style/Widget.FreeAirRadio.NavPillButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/nav_search" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/nav_settings_button"
                        style="@style/Widget.FreeAirRadio.NavPillButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/nav_settings" />

                </com.google.android.material.button.MaterialButtonToggleGroup>

            </com.google.android.material.card.MaterialCardView>

        </com.matijakljajic.freeairradio.ui.shell.BottomControlsContainer>

    </com.matijakljajic.freeairradio.ui.util.ContentWidthFrameLayout>

</FrameLayout>
