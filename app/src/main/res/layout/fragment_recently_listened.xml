<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/recently_listened_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <com.matijakljajic.freeairradio.ui.util.ContentWidthFrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center_horizontal">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recently_listened_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/screen_content_horizontal_padding"
            android:paddingTop="0dp"
            android:paddingEnd="@dimen/screen_content_horizontal_padding"
            android:paddingBottom="@dimen/player_history_overlay_edge_fade_height" />

        <TextView
            android:id="@+id/recently_listened_empty_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="@dimen/station_feed_horizontal_padding"
            android:paddingEnd="@dimen/station_feed_horizontal_padding"
            android:text="@string/recently_listened_empty"
            android:textAlignment="center"
            android:visibility="gone" />

    </com.matijakljajic.freeairradio.ui.util.ContentWidthFrameLayout>

</FrameLayout>
